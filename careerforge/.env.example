# CareerForge AI — Backend Environment Variables
# Copy this file to .env and fill in your values

# ── App ──
ENVIRONMENT=development
DEBUG=true

# ── Database (MongoDB) ──
# Local:      mongodb://localhost:27017
# Atlas free: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=careerforge

# ── AI Providers (at least one required) ──
# Groq is recommended — free tier, very fast (https://console.groq.com)
GROQ_API_KEY=

# Google Gemini (fallback, free tier available)
GEMINI_API_KEY=

# Anthropic Claude (last-resort fallback)
ANTHROPIC_API_KEY=

# ── Auth ──
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ──
# CORS_ORIGINS=["http://localhost:3000","https://yourapp.vercel.app"]

# ── File Upload ──
MAX_UPLOAD_SIZE_MB=10
